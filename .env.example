TRANSCRIPTION_ENVIRONMENT=development
TRANSCRIPTION_LOG_LEVEL=INFO
# Docker Compose supplies these local service addresses automatically. Set them
# when running the API or worker directly on the host.
TRANSCRIPTION_DATABASE_URL=postgresql://transcription:transcription@localhost:5432/transcription
TRANSCRIPTION_REDIS_URL=redis://localhost:6379/0
TRANSCRIPTION_REDIS_QUEUE_NAME=transcription:jobs
TRANSCRIPTION_MEDIA_STORAGE_PATH=./data/media
TRANSCRIPTION_MAX_STORED_MEDIA_BYTES=5368709120
TRANSCRIPTION_MAX_PENDING_JOBS=100
TRANSCRIPTION_JOB_MAX_ATTEMPTS=3
TRANSCRIPTION_JOB_RETRY_BACKOFF_SECONDS=5
TRANSCRIPTION_JOB_TIMEOUT_SECONDS=1800
TRANSCRIPTION_JOB_LEASE_SECONDS=30
TRANSCRIPTION_FAILED_MEDIA_RETENTION_SECONDS=86400
TRANSCRIPTION_RESULT_RETENTION_SECONDS=604800
TRANSCRIPTION_CLEANUP_INTERVAL_SECONDS=900
TRANSCRIPTION_WORKER_POLL_SECONDS=2
TRANSCRIPTION_WORKER_HEARTBEAT_TTL_SECONDS=15

# Keep each model ID paired with its matching pinned revision.
TRANSCRIPTION_MODEL_ID=Systran/faster-whisper-small
TRANSCRIPTION_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120
TRANSCRIPTION_LARGER_MODEL_ID=Systran/faster-whisper-large-v3
TRANSCRIPTION_LARGER_MODEL_REVISION=edaa852ec7e145841d8ffdb056a99866b5f0a478
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
TRANSCRIPTION_BEAM_SIZE=5

# Request guardrails.
TRANSCRIPTION_MAX_UPLOAD_BYTES=104857600
TRANSCRIPTION_MAX_CONCURRENT_UPLOADS=2
TRANSCRIPTION_MAX_MEDIA_DURATION_SECONDS=900
TRANSCRIPTION_CHUNK_DURATION_SECONDS=300
TRANSCRIPTION_CHUNK_MAX_ATTEMPTS=2
TRANSCRIPTION_RATE_LIMIT_REQUESTS=10
TRANSCRIPTION_RATE_LIMIT_WINDOW_SECONDS=60
