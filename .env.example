TRANSCRIPTION_ENVIRONMENT=development
TRANSCRIPTION_LOG_LEVEL=INFO

# Model settings are consumed by the inference adapter added in phase 1.
TRANSCRIPTION_MODEL_ID=Systran/faster-whisper-small
TRANSCRIPTION_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
TRANSCRIPTION_BEAM_SIZE=5

# Request guardrails.
TRANSCRIPTION_MAX_UPLOAD_BYTES=104857600
TRANSCRIPTION_MAX_MEDIA_DURATION_SECONDS=900
TRANSCRIPTION_MAX_CONCURRENT_TRANSCRIPTIONS=1
TRANSCRIPTION_INFERENCE_QUEUE_TIMEOUT_SECONDS=5
